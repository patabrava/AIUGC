# FLOW-FORGE Environment Variables
# Copy to .env and fill in your values

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_POSTGREST_TIMEOUT_SECONDS=30
SUPABASE_ACCESS_TOKEN=sbp_...

# LLM Providers
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
GEMINI_PROVIDER=vertex
GEMINI_DEEP_RESEARCH_PROVIDER=vertex_grounded
GEMINI_API_FALLBACK_ENABLED=false
GEMINI_API_KEY=
GEMINI_TOPIC_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_DEEP_RESEARCH_AGENT=deep-research-preview-04-2026
GEMINI_TOPIC_TIMEOUT_SECONDS=600
GEMINI_TOPIC_POLL_SECONDS=5
VERTEX_GEMINI_MODEL=gemini-2.5-flash
VERTEX_GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
VERTEX_GEMINI_IMAGE_LOCATION=global
SEMANTIC_SCENE_PLATE_MODEL=gemini-3.1-flash-image
SEMANTIC_SCENE_PLATE_IMAGE_SIZE=2K
SEMANTIC_SCENE_PLATE_CONTRACT_VERSION=flash-photographic-integration-v13
SEMANTIC_SCENE_PLATE_BUNDLE_ENABLED=false
SEMANTIC_SCENE_IDENTITY_GATE_LOCATION=global
SEMANTIC_SCENE_PLATE_MAX_CONCURRENCY=1
SEMANTIC_SCENE_PLATE_SUCCESS_RAMP=1
SEMANTIC_SCENE_PLATE_START_INTERVAL_SECONDS=5
SEMANTIC_SCENE_PLATE_THROTTLE_COOLDOWN_SECONDS=30
SEMANTIC_SCENE_PLATE_TRANSIENT_COOLDOWN_SECONDS=10
VERTEX_GROUNDED_RESEARCH_MODEL=gemini-2.5-pro
VERTEX_GROUNDED_RESEARCH_LOCATION=global
MAGNIFIC_API_KEY=
MAGNIFIC_BASE_URL=https://api.magnific.com
MAGNIFIC_TIMEOUT_SECONDS=60
MAGNIFIC_POLL_SECONDS=10
MAGNIFIC_WEBHOOK_SECRET=
SCENE_REFERENCE_STYLE_LORAS=bathroom_accessibility_a=bathroom-accessibility-a:65,car_transfer_residential_a=car-transfer-residential-a:65,home_living_room_advice_a=home-living-room-advice-a:65
ACTOR_IDENTITY_GATE_MODE=manual
TOPIC_AUDIT_INTERVAL_SECONDS=60
TOPIC_RESEARCH_INTERVAL_SECONDS=86400
TOPIC_WORKER_POLL_INTERVAL_SECONDS=60
SEO_TOPIC_CATALOG_ENABLED=false
ANTHROPIC_API_KEY=sk-ant-...

# Video Providers
GOOGLE_AI_API_KEY=your-google-ai-api-key
GOOGLE_AI_PROJECT_ID=project-99c2957b-20cd-400b-b25
VERTEX_AI_ENABLED=true
VERTEX_REQUIRED_PRINCIPAL_EMAIL=sarahlippe800@gmail.com
VERTEX_AI_PROJECT_ID=project-99c2957b-20cd-400b-b25
VERTEX_AI_LOCATION=us-central1
VERTEX_AI_OUTPUT_GCS_URI=gs://project-99c2957b-20cd-400b-b25-vertex-output/
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_APPLICATION_CREDENTIALS_JSON=
# SORA_API_KEY=your-sora-key  # Future implementation

# Video Storage (Cloudflare R2)
CLOUDFLARE_R2_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_R2_ACCESS_KEY_ID=your-r2-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
CLOUDFLARE_R2_BUCKET_NAME=your-r2-bucket-name
CLOUDFLARE_R2_PUBLIC_BASE_URL=https://cdn.example.com
CLOUDFLARE_R2_REGION=auto
CLOUDFLARE_R2_ENDPOINT_URL=
CLOUDFLARE_R2_VIDEO_PREFIX=flow-forge/videos
USE_URL_BASED_UPLOAD=true

# Social Media
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_REDIRECT_URI=http://localhost:8000/publish/meta/callback
TIKTOK_CLIENT_KEY=your-tiktok-key
TIKTOK_CLIENT_SECRET=your-tiktok-secret
TIKTOK_REDIRECT_URI=http://localhost:8000/publish/tiktok/callback
TIKTOK_ENVIRONMENT=sandbox
TIKTOK_SANDBOX_ACCOUNT=@your-sandbox-handle
INSTAGRAM_ACCESS_TOKEN=your-instagram-token
APP_URL=http://localhost:8000
PRIVACY_POLICY_URL=https://yourdomain.com/privacy
TERMS_URL=https://yourdomain.com/terms
TOKEN_ENCRYPTION_KEY=change-me-long-random-secret

# Auth (email OTP login)
ALLOWED_EMAIL_DOMAIN=lippelift.de
ALLOWED_EMAILS=caposk817@gmail.com,sarahlippe8@gmail.com
REVIEWER_LOGIN_EMAIL=tiktok-review@lippelift.xyz
REVIEWER_LOGIN_TOKEN=change-me-review-token
SESSION_COOKIE_NAME=ff_session
SESSION_MAX_AGE=2592000
AUTH_OTP_CODE_LENGTH=8

# Cron Security
CRON_SECRET=your-random-secret-string

# Application
DEBUG=0
LOG_LEVEL=INFO
ENVIRONMENT=development
APP_HOST=localhost
APP_PORT=8000
WEBFLOW_API_TOKEN=
WEBFLOW_SITE_ID=
WEBFLOW_COLLECTION_ID=
CLOUDFLARE_R2_IMAGE_PREFIX=flow-forge/images

# Runway Seedance 2.5 evaluation (experimental; Veo remains the production provider)
RUNWAY_EVALUATION_ENABLED=false
RUNWAY_API_KEY=
RUNWAY_API_BASE_URL=https://api.dev.runwayml.com
RUNWAY_API_TIMEOUT_SECONDS=30
RUNWAY_OUTPUT_ALLOWED_HOSTS=
RUNWAY_OUTPUT_MAX_BYTES=157286400
RUNWAY_OUTPUT_DOWNLOAD_TIMEOUT_SECONDS=180
RUNWAY_EVALUATION_OPERATOR_EMAILS=
RUNWAY_EVALUATION_ALLOWED_RESOLUTIONS=720p,1080p
RUNWAY_SEEDANCE_CREDITS_PER_SECOND_480P=20
RUNWAY_SEEDANCE_CREDITS_PER_SECOND_720P=30
RUNWAY_SEEDANCE_CREDITS_PER_SECOND_1080P=68
RUNWAY_SEEDANCE_MINIMUM_CREDITS=80
RUNWAY_USD_PER_CREDIT=0.01
RUNWAY_EVALUATION_MAX_CREDITS_PER_RUN=600
RUNWAY_EVALUATION_DAILY_CREDIT_LIMIT=2000
RUNWAY_EVALUATION_MAX_ACTIVE=1
RUNWAY_EVALUATION_MIN_SUBMIT_INTERVAL_SECONDS=30
RUNWAY_POLL_INTERVAL_SECONDS=10
RUNWAY_POLL_MAX_AGE_SECONDS=7200

# Direct BytePlus ModelArk Seedance 2.5 (evaluation-only; disabled until account access is verified)
SEEDANCE_EVALUATION_PROVIDER=modelark
MODELARK_API_KEY=
MODELARK_API_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
MODELARK_EVALUATION_ENABLED=false
MODELARK_EVALUATION_OPERATOR_EMAILS=
MODELARK_EVALUATION_ALLOWED_RESOLUTIONS=480p,720p
MODELARK_USD_PER_MILLION_TOKENS=10.70
# Integer USD microdollars: these limits represent $2/run and $10/day.
MODELARK_EVALUATION_MAX_CREDITS_PER_RUN=2000000
MODELARK_EVALUATION_DAILY_CREDIT_LIMIT=10000000
MODELARK_EVALUATION_MAX_ACTIVE=1
MODELARK_EVALUATION_MIN_SUBMIT_INTERVAL_SECONDS=30
MODELARK_POLL_INTERVAL_SECONDS=10
MODELARK_POLL_MAX_AGE_SECONDS=7200
MODELARK_OUTPUT_ALLOWED_HOSTS=ark-content-generation-ap-southeast-1.tos-ap-southeast-1.volces.com
# Optional active trusted ModelArk asset, pinned to the original upload checksum.
MODELARK_REFERENCE_ASSET_URI=
MODELARK_REFERENCE_ASSET_SHA256=
